#
#	Xbox Dash Skin Material Data
#
#	Skin Name - MS Dash - Green
#
#	Stock is the retail 5960 dashboard. Its colours live in the source
#	(theseus/render/materials_retail.inl), so this file lists nothing.
#
#	Other skins only need the materials they change. Anything a skin
#	leaves out keeps the retail colour.
#
#	example...
#	[Some Material Name]		<-- Material Name
#	Color=red,green,blue,alpha		<-- single colour materials
#	ColorA=red,green,blue,alpha		<-- falloff side colour
#	ColorB=red,green,blue,alpha		<-- falloff front colour
#
#	[Keyboard]		<-- the keyboard keys share one section
#	ColorA=Live side, ColorB=side, ColorC=bright front, ColorD=text
#
