# Build artifacts
*.ncb
*.suo
*.user
*.exe
*.xbe
*.obj
*.pch
*.pdb
*.map
*.log
*.wrn
*.ilk
*.idb
# -MMD writes these beside the compiler's cwd when a build is driven by hand.
*.d
Debug/
Release/
Profile/
Profile_FastCap/
Release_LTCG/
obj/
ddk/
# No trailing slash: theseus/xdk is usually a symlink to a local XDK tree,
# and a dir-only pattern lets the link itself get committed.
xdk
build-env/

# Reference builds
UIX-Lite-Build/

# OS junk
.DS_Store
Thumbs.db

# IDE
.vscode/
.claude/
.mcp.json
ghidra/
ida/
binary-analysis/

# Desktop build artifacts
build-desktop/

# Local build staging and backup trees (not part of the public source)
build/git-clean/
build/thinkpad-patched/
build/bin-git/
build/build.log
build/Makefile.git-test
build/Makefile.thinkpad

# Backup files
*.bak
MediaDB.cache

# xiptool extract scratch dirs. The xap source of truth lives in xips-source/.
# Data/Xips/<name>/ is just a pack staging area or leftover from an extract.
# The packed Data/Xips/*.xip files still commit; only the unpacked folders
# are ignored.
Data/Xips/*/

# bgfx build artifacts. Submodule sources live at
# theseus/third-party/{bx,bimg,bgfx}/; the .build/ output is machine specific
# and rebuilds locally.
theseus/third-party/bgfx/.build/

# xiptool writes <folder>.xip next to the source folder on create. The packed
# artifact belongs in Data/Xips/, not here.
xips-source/*.xip
